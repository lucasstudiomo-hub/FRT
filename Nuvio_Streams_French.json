{
  "services": [],
  "presets": [
    {
      "type": "comet",
      "instanceId": "1c5",
      "enabled": true,
      "options": {
        "name": "Comet",
        "timeout": 8000,
        "resources": [
          "stream"
        ],
        "includeP2P": true,
        "removeTrash": true,
        "mediaTypes": []
      }
    },
    {
      "type": "stremthruTorz",
      "instanceId": "e7b",
      "enabled": true,
      "options": {
        "name": "StremThru Torz",
        "timeout": 10000,
        "resources": [
          "stream"
        ],
        "mediaTypes": [],
        "includeP2P": true,
        "useMultipleInstances": false
      }
    },
    {
      "type": "hdhub",
      "instanceId": "bb4",
      "enabled": true,
      "options": {
        "name": "HdHub",
        "timeout": 7500,
        "resources": [
          "stream"
        ],
        "mediaTypes": [],
        "tb_only": false
      }
    }
  ],
  "formatter": {
    "id": "custom",
    "definition": {
      "name": "{stream.title::exists[\"{stream.title}\"||\"\"]}",
      "description": "👥 {stream.seeders} - 📂 {stream.size::>0[\"{stream.size::bytes}\"||\"\"]} - {stream.languageEmojis::exists[\"{stream.languageEmojis}\"||\"\"]}"
    }
  },
  "preferredQualities": [
    "BluRay REMUX",
    "BluRay",
    "WEB-DL",
    "WEBRip",
    "HDRip",
    "HC HD-Rip",
    "DVDRip",
    "HDTV",
    "Unknown"
  ],
  "preferredResolutions": [
    "2160p",
    "1080p",
    "720p"
  ],
  "excludedQualities": [
    "CAM",
    "SCR",
    "TS",
    "TC"
  ],
  "excludedVisualTags": [
    "3D"
  ],
  "sortCriteria": {
    "global": [
      {
        "key": "resolution",
        "direction": "desc"
      },
      {
        "key": "language",
        "direction": "desc"
      },
      {
        "key": "seeders",
        "direction": "desc"
      },
      {
        "key": "size",
        "direction": "desc"
      }
    ],
    "uncached": [
      {
        "key": "seeders",
        "direction": "desc"
      },
      {
        "key": "resolution",
        "direction": "desc"
      },
      {
        "key": "size",
        "direction": "desc"
      }
    ]
  },
  "deduplicator": {
    "enabled": true,
    "excludeAddons": [],
    "multiGroupBehaviour": "aggressive",
    "keys": [
      "filename",
      "infoHash"
    ],
    "cached": "per_addon",
    "uncached": "per_service",
    "p2p": "single_result"
  },
  "trusted": false,
  "excludedResolutions": [
    "144p",
    "240p",
    "360p",
    "480p",
    "576p"
  ],
  "includedResolutions": [],
  "requiredResolutions": [],
  "includedQualities": [],
  "requiredQualities": [],
  "excludedLanguages": [],
