  "dynamicAddonFetching": {
    "enabled": false,
    "condition": "count(totalStreams) >= 15 or totalTimeTaken >= 10000"
  },
  "groups": {
    "enabled": true,
    "groupings": [
      {
        "addons": [
          "1c5",
          "bb4"
        ],
        "condition": "true"
      },
      {
        "addons": [
          "e7b"
        ],
        "condition": "(count(resolution(cached(totalStreams), '2160p')) < 5 and count(resolution(cached(totalStreams), '1080p')) < 5 and count(resolution(cached(totalStreams), '720p')) < 5) and totalTimeTaken < 5000"
      }
    ],
    "behaviour": "parallel"
  },
  "proxy": {
    "enabled": false,
    "id": "builtin",
    "proxiedAddons": [],
    "proxiedServices": []
  },
  "resultLimits": {
