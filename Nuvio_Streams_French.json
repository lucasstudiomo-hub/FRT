  "requiredAudioTags": [],
  "preferredAudioTags": [],
  "excludedAudioChannels": [],
  "includedAudioChannels": [],
  "requiredAudioChannels": [],
  "preferredAudioChannels": [],
  "excludedStreamTypes": [],
  "includedStreamTypes": [],
  "requiredStreamTypes": [],
